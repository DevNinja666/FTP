using System;
using System.IO;
using System.Net.Sockets;
using System.Text;
using System.Threading;

class FtpClient
{
    TcpClient control;
    StreamReader reader;
    StreamWriter writer;

    public bool Connect(string host, int port)
    {
        try
        {
            control = new TcpClient(host, port);
            reader = new StreamReader(control.GetStream(), Encoding.UTF8);
            writer = new StreamWriter(control.GetStream(), Encoding.UTF8) { AutoFlush = true };
            Console.WriteLine(reader.ReadLine());
            return true;
        }
        catch { return false; }
    }

    public void SendCommand(string cmd)
    {
        writer.WriteLine(cmd);
        string line;
        while ((line = reader.ReadLine()) != null)
        {
            Console.WriteLine(line);
            if (line.StartsWith("OK LIST_END") || line.StartsWith("OK") || line.StartsWith("ERR") || line.StartsWith("BYE")) break;
        }
    }

    public int UploadFile(string localPath, string remoteDir, int streams = 1)
    {
        var fi = new FileInfo(localPath);
        writer.WriteLine($"UPLOAD_INIT {remoteDir} {fi.Name} {fi.Length} {streams}");
        var resp = reader.ReadLine();
        Console.WriteLine(resp);
        if (!resp.StartsWith("OK PORT")) return -1;
        var port = int.Parse(resp.Split(' ')[2]);
        using var fs = new FileStream(localPath, FileMode.Open, FileAccess.Read);
        var jobs = new Thread[streams];
        long partSize = fi.Length / streams;
        long rem = fi.Length % streams;
        for (int i = 0; i < streams; i++)
        {
            long offset = i * partSize + Math.Min(i, rem);
            long size = partSize + (i < rem ? 1 : 0);
            jobs[i] = new Thread(() => UploadPart(port, fs, offset, size));
            jobs[i].Start();
        }
        foreach (var t in jobs) t.Join();
        return 0;
    }

    void UploadPart(int port, FileStream fs, long offset, long length)
    {
        var tcp = new TcpClient("127.0.0.1", port);
        using var ns = tcp.GetStream();
        lock (fs)
        {
            ns.Write(BitConverter.GetBytes(offset));
            ns.Write(BitConverter.GetBytes(length));
            fs.Seek(offset, SeekOrigin.Begin);
            var remaining = length;
            var buffer = new byte[64 * 1024];
            while (remaining > 0)
            {
                int toRead = (int)Math.Min(buffer.Length, remaining);
                int read = fs.Read(buffer, 0, toRead);
                if (read <= 0) break;
                ns.Write(buffer, 0, read);
                remaining -= read;
            }
        }
        tcp.Close();
    }

    public int DownloadFile(string remoteDir, string filename, string localPath, int streams = 1)
    {
        writer.WriteLine($"DOWNLOAD_INIT {remoteDir} {filename} {streams}");
        var resp = reader.ReadLine();
        Console.WriteLine(resp);
        if (!resp.StartsWith("OK PORT")) return -1;
        var port = int.Parse(resp.Split(' ')[2]);
        using var fs = new FileStream(localPath, FileMode.OpenOrCreate, FileAccess.Write);
        var jobs = new Thread[streams];
        for (int i = 0; i < streams; i++)
        {
            int idx = i;
            jobs[i] = new Thread(() => DownloadPart(port, fs, idx));
            jobs[i].Start();
        }
        foreach (var t in jobs) t.Join();
        return 0;
    }

    void DownloadPart(int port, FileStream fs, int idx)
    {
        var tcp = new TcpClient("127.0.0.1", port);
        using var ns = tcp.GetStream();
        var buffer = new byte[64 * 1024];
        byte[] offsetBytes = new byte[8];
        byte[] lengthBytes = new byte[8];
        ns.Read(offsetBytes, 0, 8);
        ns.Read(lengthBytes, 0, 8);
        long offset = BitConverter.ToInt64(offsetBytes, 0);
        long length = BitConverter.ToInt64(lengthBytes, 0);
        lock (fs)
        {
            fs.Seek(offset, SeekOrigin.Begin);
            long remaining = length;
            while (remaining > 0)
            {
                int toRead = (int)Math.Min(buffer.Length, remaining);
                int read = ns.Read(buffer, 0, toRead);
                if (read <= 0) break;
                fs.Write(buffer, 0, read);
                remaining -= read;
            }
        }
        tcp.Close();
    }

    public void Quit()
    {
        writer.WriteLine("QUIT");
        Console.WriteLine(reader.ReadLine());
        control.Close();
    }
}

class Program
{
    static void Main()
    {
        var client = new FtpClient();
        if (!client.Connect("127.0.0.1", 9000)) { Console.WriteLine("Cannot connect"); return; }
        while (true)
        {
            Console.Write("ftp> ");
            var line = Console.ReadLine();
            if (string.IsNullOrWhiteSpace(line)) continue;
            var cmd = line.Split(' ')[0].ToUpperInvariant();
            if (cmd == "UPLOAD")
            {
                var tokens = line.Split(' ', 3);
                if (tokens.Length < 3) { Console.WriteLine("Usage: UPLOAD localPath remoteDir"); continue; }
                client.UploadFile(tokens[1], tokens[2], 4);
            }
            else if (cmd == "DOWNLOAD")
            {
                var tokens = line.Split(' ', 4);
                if (tokens.Length < 4) { Console.WriteLine("Usage: DOWNLOAD remoteDir filename localPath"); continue; }
                client.DownloadFile(tokens[1], tokens[2], tokens[3], 4);
            }
            else if (cmd == "QUIT")
            {
                client.Quit();
                break;
            }
            else
            {
                client.SendCommand(line);
            }
        }
    }
}
